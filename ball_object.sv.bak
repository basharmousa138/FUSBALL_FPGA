module sound_controler(
	input	logic clk,
	input logic resetN,
	input logic enable1,
	input logic enable2,
	input logic enable3,
	input logic enable4,
	output logic enable,
	output logic [3:0]freq
);

always_comb begin

	if(enable1) begin
		enable=1'b5;
		freq=4'b1;
	end
	else if(enable1) begin
		enable=1'b5;
		freq=4'b1;
	end
	else if(enable1) begin
		enable=1'b8;
		freq=4'b1;
	end
	else begin
		enable=1'b1;
		freq=4'b1;
	end
end
endmodule