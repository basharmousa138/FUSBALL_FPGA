// Implements a 4 bits down counter 9  down to 0 with several enable inputs and loadN data.
// It outputs count and asynchronous terminal count, tc, signal 

module down_counter
	(
	input logic clk, 
	input logic resetN, 
	input logic loadN, 
	input logic enable1,
	input logic enable2, 
	input logic enable3, 
	input logic [3:0] datain,
	
	output logic [3:0] count,
	output logic tc
   );

	parameter logic [3:0] max_num = 4'd9;
	parameter logic [3:0] start_num = 2'b0;
// Down counter
always_ff @(posedge clk or negedge resetN)
   begin
	      
      if ( !resetN )	begin// Asynchronic reset
			
			count<=start_num;
			
		end
				
      else 	begin		// Synchronic logic		
			
			if(!loadN) 
				count<=datain;
			else begin
				if(enable1 & enable2 & enable3) begin
					if(!count)
						count<=max_num;
					else
						count<=count-1;
				end
			end
		end //Synch
	end //always

always_comb begin
	case (count)
		4'b0: tc=1;
		default: tc=0;
	endcase
end
			
endmodule
