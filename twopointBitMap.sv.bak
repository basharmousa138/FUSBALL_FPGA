module	Timer_objects_mux	(	
//		--------	Clock Input	 	

					input		logic	Minutes, // two set of inputs per unit
					 
		  // players blue
					input		logic	Seconds1, // two set of inputs per unit

			// players red		
					input		logic	Seconds2, // two set of inputs per unit
			  
		  ////////////////////////
		  // background 
					input    logic twoPoint, // box of numbers
					
					output 	logic TimerDR,
				   output	logic	[7:0] RGBOut
);

assign TimerDR= Minutes | Seconds1 | Seconds2 | twoPoint;

parameter  logic	[7:0] digit_color = 8'h00 ;

assign RGBOut= digit_color;

endmodule

