module timerDone(
	input logic clk,
	input logic resetN,
	input logic minutesTC,
	input logic seconds1TC,
	input logic seconds2TC,
	output logic gameEnd
);


enum logic [1:0] {s_idle, s_minute, s_second1} timer_ps, timer_ns;

always_ff@(posedge clk or negedge resetN)
begin
	if(!resetN) begin
		timer_ps <=	s_idle;
	end
	else begin
		timer_ps<=timer_ns;
	end 
end

always_comb begin

	stimer_ns<=timer_ps;
	gameEnd=1'b0;
	
	case(timer_ps)
		
		s_idle: begin
			if(minutesTC)
				timer_ns<=s_minute;
		end
		
		s_minute: begin
			if(seconds1TC)
				timer_ns<=s_second1;
		end

		s_second1: begin
			if(seconds2TC) begin
				timer_ns<=s_idle;
				gameEnd=1'b1;
			end
		end
	endcase
end
endmodule
		