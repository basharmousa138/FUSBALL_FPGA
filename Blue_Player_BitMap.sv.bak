// (c) Technion IIT, Department of Electrical Engineering 2021


module	back_ground_draw	(	

					input		logic	clk,
					input		logic	resetN,
					input 	logic	[10:0]	pixelX,
					input 	logic	[10:0]	pixelY,
					input 	logic 	gameWelcome,

					output	logic	[7:0]	BG_RGB,
					output	logic		boardersDrawReq, 
					output	logic		redGoalsDrawReq, 
					output	logic		blueGoalsDrawReq
);

localparam  int	xFrameSize	=	631;
const int	yFrameSize	=	480;
localparam  int	bracketOffsetx =	0;
const int	bracketOffsety =	70;
const int   COLOR_MARTIX_SIZE  = 16*8 ; // 128 

logic [2:0] redBits;
logic [2:0] greenBits;
logic [1:0] blueBits;
logic [10:0] shift_pixelX;


localparam logic [2:0] DARK_COLOR = 3'b111 ;// bitmap of a dark color
localparam logic [2:0] LIGHT_COLOR = 3'b000 ;// bitmap of a light color

 
localparam  int RED_TOP_Y  = 156 ;
localparam  int RED_LEFT_X  = 256 ;
localparam  int GREEN_RIGHT_X  = 32 ;
localparam  int BLUE_BOTTOM_Y  = 300 ;
localparam  int BLUE_RIGHT_X  = 200 ;
 
parameter  logic [10:0] COLOR_MATRIX_TOP_Y  = 100 ; 
parameter  logic [10:0] COLOR_MATRIX_LEFT_X = 100 ;

//our parameters
localparam  int border_width=12;
localparam  int GK_y=70;
localparam  int Pen_x=80;
localparam  int Pen_y=110;
localparam int line_width=5;
localparam int first_line_st=46;
localparam int second_line_st=137;
localparam int third_line_st=237;
localparam int fourth_line_st=xFrameSize-third_line_st-bracketOffsetx;
localparam int fifth_line_st=xFrameSize-second_line_st-bracketOffsetx;
localparam int sixth_line_st=xFrameSize-first_line_st-bracketOffsetx;



// this is a block to generate the background 
//it has four sub modules : 

	// 1. draw the yellow borders
	// 2. draw four lines with "bracketOffset" offset from the border 
	// 3.  draw red rectangle at the bottom right,  green on the left, and blue on top left 
	// 4. draw a matrix of 16*16 rectangles with all the colors, each rectsangle 8*8 pixels  	

 
 
always_ff@(posedge clk or negedge resetN)
begin
	if(!resetN) begin
				redBits <= DARK_COLOR ;	
				greenBits <= DARK_COLOR  ;	
				blueBits <= DARK_COLOR ;	 
	end 
	else begin

	// defaults 
		greenBits <= 3'b100 ; 
		redBits <= 3'b000 ;
		blueBits <= LIGHT_COLOR;
		boardersDrawReq <= 	1'b0 ; 
		redGoalsDrawReq <= 1'b0;
		blueGoalsDrawReq <= 1'b0;

		// draw  four lines with "bracketOffset" offset from the border 
		
		if (        (pixelX >= bracketOffsetx && pixelX <= bracketOffsetx+border_width && ((pixelY <= ((yFrameSize+bracketOffsety)/2)-GK_y) ||  ((pixelY <= (yFrameSize-2) && pixelY >= ((yFrameSize+bracketOffsety)/2)+GK_y))))||
						(((pixelY >= bracketOffsety && pixelY <= bracketOffsety+border_width)|| pixelY <= border_width) && pixelX >= bracketOffsetx && pixelX <= (xFrameSize-bracketOffsetx) )||
						(pixelX <= (xFrameSize-bracketOffsetx) && pixelX >= (xFrameSize-bracketOffsetx-border_width) && ((pixelY <= ((yFrameSize+bracketOffsety)/2)-GK_y) ||  ((pixelY <= (yFrameSize-2) && pixelY >= ((yFrameSize+bracketOffsety)/2)+GK_y)))) || 
						(pixelY <= (yFrameSize-2) && pixelY >= (yFrameSize-2)-border_width && pixelX >= bracketOffsetx && pixelX <= (xFrameSize-bracketOffsetx) )) 
			begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
					boardersDrawReq <= 	1'b1 ; // pulse if drawing the boarders 
			end
	
	// drawing the goal area
		
		if (pixelX >= bracketOffsetx && pixelX <= bracketOffsetx+border_width/3 && pixelY >= ((yFrameSize+bracketOffsety)/2)-GK_y && pixelY <= ((yFrameSize+bracketOffsety)/2)+GK_y)
			begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
					redGoalsDrawReq <= 1'b1;
			end
			if (pixelX <= (xFrameSize-bracketOffsetx) && pixelX >= (xFrameSize-bracketOffsetx-border_width/3) && pixelY >= ((yFrameSize+bracketOffsety)/2)-GK_y && pixelY <= ((yFrameSize+bracketOffsety)/2)+GK_y)
            begin
               redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
					blueGoalsDrawReq <= 1'b1;
				end
	// drawing the penalty area
		
		if (        (pixelY == ((yFrameSize+bracketOffsety)/2)+Pen_y && pixelX>=bracketOffsetx && pixelX<=bracketOffsetx+Pen_x )||
						(pixelY == ((yFrameSize+bracketOffsety)/2)-Pen_y && pixelX>=bracketOffsetx && pixelX<=bracketOffsetx+Pen_x )||
						(pixelX == bracketOffsetx+Pen_x && pixelY <= ((yFrameSize+bracketOffsety)/2)+Pen_y && pixelY >= ((yFrameSize+bracketOffsety)/2)-Pen_y )||
						(pixelY == ((yFrameSize+bracketOffsety)/2)+Pen_y && xFrameSize-pixelX>=bracketOffsetx && xFrameSize-pixelX<=bracketOffsetx+Pen_x )||
						(pixelY == ((yFrameSize+bracketOffsety)/2)-Pen_y && xFrameSize-pixelX>=bracketOffsetx && xFrameSize-pixelX<=bracketOffsetx+Pen_x )||
						(xFrameSize-pixelX == bracketOffsetx+Pen_x && pixelY <= ((yFrameSize+bracketOffsety)/2)+Pen_y && pixelY >= ((yFrameSize+bracketOffsety)/2)-Pen_y ))
			begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
			end
	//drwaing the center line
	if (pixelX == xFrameSize/2 && pixelY >= bracketOffsety && pixelY <= (yFrameSize-2))
			begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
			end
	//drwaing the center circle
	if ((pixelX-xFrameSize/2)*(pixelX-xFrameSize/2)+(pixelY-(yFrameSize+bracketOffsety)/2)*(pixelY-(yFrameSize+bracketOffsety)/2)>=80*80 &&
		(pixelX-xFrameSize/2)*(pixelX-xFrameSize/2)+(pixelY-(yFrameSize+bracketOffsety)/2)*(pixelY-(yFrameSize+bracketOffsety)/2)<=81*81)
			begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
			end
	//drwaing the players lines
	if (!gameWelcome && ((pixelX >= bracketOffsetx+first_line_st && pixelX <= bracketOffsetx+first_line_st+line_width ||
			pixelX >= bracketOffsetx+second_line_st && pixelX <= bracketOffsetx+second_line_st+line_width ||
			pixelX >= bracketOffsetx+third_line_st && pixelX <= bracketOffsetx+third_line_st+line_width ||
			pixelX >= fourth_line_st && pixelX <= fourth_line_st+line_width ||
			pixelX >= fifth_line_st && pixelX <= fifth_line_st+line_width ||
			pixelX >= sixth_line_st && pixelX <= sixth_line_st+line_width ) &&
			(pixelY >= bracketOffsety && pixelY <= (yFrameSize-2))))
			begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
			end
	
	//header draw
	if( (pixelX >= bracketOffsetx+third_line_st && pixelX <= bracketOffsetx+third_line_st+line_width ||
			pixelX >= fourth_line_st && pixelX <= fourth_line_st+line_width )&&
			(pixelY<=bracketOffsety)) 	begin 
					redBits <= DARK_COLOR ;	
					greenBits <= DARK_COLOR  ;	
					blueBits <= DARK_COLOR ;
		end
	
	BG_RGB =  {redBits , greenBits , blueBits} ; //collect color nibbles to an 8 bit word 
			


	end; 	
end 
endmodule

